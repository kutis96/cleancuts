{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kutis96/cleancuts/schemas/machine.schema.json",
  "title": "CleanCuts machine",
  "description": "A portable machine + post-processor description. See docs/gcode.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "dialect", "units", "axes", "post_processor"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "dialect": {
      "type": "string",
      "enum": ["grbl", "linuxcnc", "fanuc", "generic"],
      "description": "Controller family. Unknown dialects are treated as 'generic'."
    },
    "units": {
      "type": "string",
      "enum": ["mm", "inch"],
      "description": "The only place units conversion happens (ADR-001)."
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "description": "Linear axes, travel, and feed/rapid limits.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["letter", "min", "max", "max_feed", "max_rapid"],
        "properties": {
          "letter": { "type": "string", "enum": ["X", "Y", "Z", "A", "B", "C"] },
          "min": { "type": "number", "description": "Travel min (mm or in, per units)." },
          "max": { "type": "number", "description": "Travel max." },
          "max_feed": { "type": "number", "exclusiveMinimum": 0 },
          "max_rapid": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "spindle_max_rpm": { "type": "number", "minimum": 0 },
    "wcs": { "type": "string", "description": "Work coordinate word, e.g. 'G54'." },
    "safe_height": { "type": "number", "description": "Default rapid safe height (mm or in)." },
    "tool_change": { "type": "string", "description": "Tool word, e.g. 'T'." },
    "max_feed": { "type": "number", "minimum": 0, "description": "Max cutting feed (per units). 0 = no limit. Cutting moves clamp to [min_feed, max_feed] (ADR-010)." },
    "min_feed": { "type": "number", "minimum": 0, "description": "Min cutting feed (per units). 0 = no minimum." },
    "max_rapid": { "type": "number", "minimum": 0, "description": "Max rapid feed (per units). 0 = no limit. Rapid moves clamp to [min_rapid, max_rapid] (ADR-010)." },
    "min_rapid": { "type": "number", "minimum": 0, "description": "Min rapid feed (per units). 0 = no minimum." },
    "post_processor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arc_format"],
      "properties": {
        "spindle_start": { "type": "integer", "default": 3, "description": "M-code, e.g. M3." },
        "spindle_stop": { "type": "integer", "default": 5 },
        "program_end": { "type": "integer", "default": 2 },
        "coolant_on": { "type": "integer", "default": 8 },
        "coolant_off": { "type": "integer", "default": 9 },
        "arc_format": {
          "type": "string",
          "enum": ["ij", "absolute"],
          "description": "'ij' = centre offsets relative to arc start; 'absolute' = explicit centre."
        },
        "header_lines": { "type": "array", "items": { "type": "string" } },
        "footer_lines": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
